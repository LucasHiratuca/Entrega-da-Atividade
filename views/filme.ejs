<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= filme.title %> — Catálogo Tom Hanks</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="navbar-brand">🎬 Catálogo Tom Hanks</a>
    <div class="navbar-links">
      <a href="/filmes">Filmes</a>
      <a href="/favoritos">⭐ Favoritos</a>
      <span class="navbar-user">Olá, <%= userName %></span>
      <a href="/logout">Sair</a>
    </div>
  </nav>

  <div class="container">
    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="movie-detail">
      <% if (filme.poster_path) { %>
        <img
          src="https://image.tmdb.org/t/p/w500<%= filme.poster_path %>"
          alt="<%= filme.title %>"
        >
      <% } %>

      <div class="movie-info">
        <h1><%= filme.title %></h1>
        <div class="meta">
          <% if (filme.release_date) { %>
            📅 <%= filme.release_date %>
          <% } %>
          <% if (filme.vote_average) { %>
            &nbsp;|&nbsp; ⭐ <%= filme.vote_average.toFixed(1) %>/10
          <% } %>
          <% if (filme.runtime) { %>
            &nbsp;|&nbsp; ⏱ <%= filme.runtime %> min
          <% } %>
        </div>

        <% if (filme.overview) { %>
          <p class="overview"><%= filme.overview %></p>
        <% } else { %>
          <p class="overview" style="color: var(--cor-texto-suave);">Sinopse não disponível em português.</p>
        <% } %>

        <div class="favorite-actions">
          <% if (isFavorito) { %>
            <form action="/favorito/remover" method="POST" style="display:inline;">
              <input type="hidden" name="tmdb_movie_id" value="<%= filme.id %>">
              <button type="submit" class="btn btn-danger">💔 Remover dos favoritos</button>
            </form>
          <% } else { %>
            <form action="/favorito/adicionar" method="POST" style="display:inline;">
              <input type="hidden" name="tmdb_movie_id" value="<%= filme.id %>">
              <input type="hidden" name="titulo" value="<%= filme.title %>">
              <input type="hidden" name="poster_path" value="<%= filme.poster_path %>">
              <button type="submit" class="btn btn-primary" style="width:auto;">⭐ Favoritar</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Comentários -->
    <div class="comments-section">
      <h3>💬 Meus comentários</h3>

      <form class="comment-form" action="/comentario/adicionar" method="POST">
        <input type="hidden" name="tmdb_movie_id" value="<%= filme.id %>">
        <textarea name="texto" placeholder="Escreva seu comentário sobre o filme..." required></textarea>
        <button type="submit" class="btn btn-primary" style="width:auto;">Comentar</button>
      </form>

      <div class="comment-list">
        <% if (comentarios.length === 0) { %>
          <p style="color: var(--cor-texto-suave); margin-top: 1rem;">
            Você ainda não comentou este filme.
          </p>
        <% } else { %>
          <% comentarios.forEach(function(c) { %>
            <div class="comment-item">
              <div class="comment-date">
                📅 <%= new Date(c.criado_em).toLocaleString('pt-BR') %>
              </div>
              <div class="comment-text"><%= c.texto %></div>
              <div class="comment-actions">
                <form action="/comentario/remover" method="POST" style="display:inline;">
                  <input type="hidden" name="comentario_id" value="<%= c.id %>">
                  <input type="hidden" name="tmdb_movie_id" value="<%= filme.id %>">
                  <button type="submit" class="btn btn-danger btn-small">🗑 Excluir</button>
                </form>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
