<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>🎬 Tom Hanks Collection | Perfil</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .profile-wrapper {
      max-width: 760px;
      margin: 2.5rem auto;
      padding: 0 1rem;
    }
    .profile-card {
      background: linear-gradient(145deg, rgba(24,24,27,0.9), rgba(9,9,11,0.95));
      border: 1px solid rgba(255,255,255,0.06);
      border-top: 1px solid rgba(245,158,11,0.2);
      border-radius: 20px;
      padding: 2.5rem;
      display: flex;
      gap: 2rem;
      align-items: flex-start;
      margin-bottom: 2rem;
    }
    .avatar-wrap { flex-shrink: 0; }
    .avatar-img {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(245,158,11,0.4);
      display: block;
    }
    .avatar-placeholder {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: rgba(245,158,11,0.07);
      border: 2px solid rgba(245,158,11,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
    }
    .profile-info { flex: 1; min-width: 0; }
    .profile-name {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text-light);
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }
    .profile-bio {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 1.2rem;
      min-height: 1.5rem;
    }
    .btn-edit-perfil {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1.1rem;
      background: rgba(245,158,11,0.07);
      border: 1px solid rgba(245,158,11,0.2);
      color: var(--primary);
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.2s;
    }
    .btn-edit-perfil:hover { background: rgba(245,158,11,0.14); }

    .section-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }
    .fav-section {
      background: linear-gradient(145deg, rgba(24,24,27,0.9), rgba(9,9,11,0.95));
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      padding: 1.8rem;
    }
    .fav-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: 1rem;
      margin-top: 0.8rem;
    }
    .fav-item {
      text-align: center;
      text-decoration: none;
    }
    .fav-poster {
      width: 100%;
      aspect-ratio: 2/3;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.06);
      display: block;
      margin-bottom: 0.4rem;
    }
    .fav-poster-placeholder {
      width: 100%;
      aspect-ratio: 2/3;
      background: rgba(245,158,11,0.05);
      border: 1px solid rgba(245,158,11,0.1);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      margin-bottom: 0.4rem;
    }
    .fav-titulo {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.3;
    }
    .empty-msg { color: var(--text-muted); font-size: 0.9rem; }

    .alert { padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.875rem; }
    .alert-error   { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #86efac; }

    @media (max-width: 540px) {
      .profile-card { flex-direction: column; align-items: center; text-align: center; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="brand">🎬 Tom Hanks Collection</a>
    <div class="nav-links">
      <a href="/filmes">Catálogo</a>
      <a href="/favoritos">Meus Favoritos</a>
      <a href="/perfil/<%= user.userId || user.id %>" style="color: var(--primary);">Meu Perfil</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin/usuarios">⚙️ Admin</a>
      <% } %>
      <span class="user-badge <%= user.role === 'admin' ? 'admin-badge' : '' %>">
        👤 <%= user.nome %> <%= user.role === 'admin' ? '(Admin)' : '' %>
      </span>
      <a href="/logout" style="color: var(--accent);">Sair</a>
    </div>
  </nav>

  <div class="profile-wrapper">

    <% if (error && error.length) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>
    <% if (success && success.length) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>

    <!-- CARD DO PERFIL -->
    <div class="profile-card">
      <div class="avatar-wrap">
        <% if (fotoUrl) { %>
          <img class="avatar-img" src="<%= fotoUrl %>" alt="Foto de <%= nomeExibicao %>">
        <% } else { %>
          <div class="avatar-placeholder">👤</div>
        <% } %>
      </div>
      <div class="profile-info">
        <div class="profile-name"><%= nomeExibicao %></div>
        <p class="profile-bio"><%= bio || 'Sem bio ainda.' %></p>
        <% if (ehDono) { %>
          <a class="btn-edit-perfil" href="/perfil/<%= perfilUsuarioId %>/editar">✏️ Editar Perfil</a>
        <% } %>
      </div>
    </div>

    <!-- FAVORITOS -->
    <div class="fav-section">
      <p class="section-title">⭐ Filmes Favoritos</p>
      <% if (favoritos && favoritos.length > 0) { %>
        <div class="fav-grid">
          <% favoritos.forEach(function(f) { %>
            <a class="fav-item" href="/filme/<%= f.tmdb_movie_id %>">
              <% if (f.poster_path) { %>
                <img class="fav-poster" src="https://image.tmdb.org/t/p/w300<%= f.poster_path %>" alt="<%= f.titulo %>">
              <% } else { %>
                <div class="fav-poster-placeholder">🎬</div>
              <% } %>
              <span class="fav-titulo"><%= f.titulo %></span>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="empty-msg">Nenhum favorito adicionado ainda.</p>
      <% } %>
    </div>

  </div>
</body>
</html>
