<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>🎬 Tom Hanks Collection | Admin</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="brand">🎬 Tom Hanks Collection</a>
    <div class="nav-links">
      <a href="/filmes">Catálogo</a>
      <a href="/favoritos">Meus Favoritos</a>
      <a href="/admin/usuarios" style="color: var(--primary);">⚙️ Admin</a>
      <span class="user-badge admin-badge">👤 <%= user.nome %> (Admin)</span>
      <a href="/logout" style="color: var(--accent);">Sair</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
      <h2>⚙️ Painel de Administração</h2>
      <a href="/admin/logs" class="btn btn-ghost">📜 Ver Logs de Auditoria</a>
    </div>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
        <thead>
          <tr style="border-bottom: 2px solid var(--primary); text-align: left;">
            <th style="padding: 0.8rem; color: var(--primary);">ID</th>
            <th style="padding: 0.8rem; color: var(--primary);">Nome</th>
            <th style="padding: 0.8rem; color: var(--primary);">E-mail</th>
            <th style="padding: 0.8rem; color: var(--primary);">Papel Atual</th>
            <th style="padding: 0.8rem; color: var(--primary);">Cadastro</th>
            <th style="padding: 0.8rem; color: var(--primary);">Ação</th>
          </tr>
        </thead>
        <tbody>
          <% usuarios.forEach(function(u) { %>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
              <td style="padding: 0.8rem;"><%= u.id %></td>
              <td style="padding: 0.8rem;"><%= u.nome %></td>
              <td style="padding: 0.8rem; color: var(--text-muted);"><%= u.email %></td>
              <td style="padding: 0.8rem;">
                <span class="user-badge <%= u.role === 'admin' ? 'admin-badge' : '' %>" style="display: inline-block;">
                  <%= u.role === 'admin' ? '🛡️ Admin' : '👤 Usuário' %>
                </span>
              </td>
              <td style="padding: 0.8rem; color: var(--text-muted);"><%= new Date(u.criado_em).toLocaleDateString('pt-BR') %></td>
              <td style="padding: 0.8rem;">
                <% if (u.id !== user.userId) { %>
                  <form action="/admin/usuarios/<%= u.id %>/role" method="POST" style="display: inline;">
                    <% if (u.role === 'usuario') { %>
                      <input type="hidden" name="role" value="admin">
                      <button type="submit" class="btn btn-primary" style="width: auto; padding: 0.4rem 1rem; font-size: 0.85rem;">
                        Promover a Admin
                      </button>
                    <% } else { %>
                      <input type="hidden" name="role" value="usuario">
                      <button type="submit" class="btn btn-danger" style="width: auto; padding: 0.4rem 1rem; font-size: 0.85rem;">
                        Rebaixar a Usuário
                      </button>
                    <% } %>
                  </form>
                <% } else { %>
                  <span style="color: var(--text-muted); font-size: 0.85rem;">Você</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<script type="module" src="/js/iridescence.js"></script></body>
</html>

