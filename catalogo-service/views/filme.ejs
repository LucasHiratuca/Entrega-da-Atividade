<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= filme.title %> | Catálogo</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="brand">🎬 Tom Hanks Collection</a>
    <div class="nav-links">
      <a href="/filmes">Catálogo</a>
      <a href="/favoritos">Meus Favoritos</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin/usuarios">⚙️ Admin</a>
      <% } %>
      <span class="user-badge <%= user.role === 'admin' ? 'admin-badge' : '' %>">
        👤 <%= user.nome %> <%= user.role === 'admin' ? '(Admin)' : '' %>
      </span>
      <a href="/logout" style="color: var(--accent);">Sair</a>
    </div>
  </nav>

  <div class="container">
    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="hero-movie">
      <img class="hero-poster" src="https://image.tmdb.org/t/p/w500<%= filme.poster_path %>" alt="<%= filme.title %>">
      <div class="hero-content">
        <h1><%= filme.title %></h1>
        <div class="hero-meta">
          <span>📅 <%= filme.release_date ? filme.release_date.split('-')[0] : 'N/A' %></span>
          <span>⏱️ <%= filme.runtime %> min</span>
          <span>⭐ <%= filme.vote_average.toFixed(1) %> / 10</span>
        </div>
        <div class="hero-overview"><%= filme.overview || 'Sinopse indisponível.' %></div>
        
        <div class="actions-wrapper">
          <% if (isFavorito) { %>
            <form action="/favorito/remover" method="POST">
              <input type="hidden" name="tmdb_movie_id" value="<%= filme.id %>">
              <button type="submit" class="btn btn-danger">Remover dos Favoritos ⭐</button>
            </form>
          <% } else { %>
            <form action="/favorito/adicionar" method="POST">
              <input type="hidden" name="tmdb_movie_id" value="<%= filme.id %>">
              <input type="hidden" name="titulo" value="<%= filme.title %>">
              <input type="hidden" name="poster_path" value="<%= filme.poster_path %>">
              <button type="submit" class="btn btn-outline">Adicionar aos Favoritos 🤍</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <div class="comments-section">
      <h3 style="margin-bottom: 1rem; color: var(--primary);">Comentários</h3>
      
      <form action="/comentario/adicionar" method="POST" class="comment-form">
        <input type="hidden" name="tmdb_movie_id" value="<%= filme.id %>">
        <textarea name="texto" required placeholder="O que você achou deste filme?"></textarea>
        <button type="submit" class="btn btn-primary" style="width: auto; padding: 0.8rem 2rem;">Enviar comentário</button>
      </form>

      <% if (comentarios.length > 0) { %>
        <% comentarios.forEach(function(c) { %>
          <div class="comment-card">
            <div class="comment-header">
              <span class="comment-author">
                <%= c.autor_nome || 'Usuário removido' %>
                <% if (c.usuario_id === userId) { %>
                  <span style="color: var(--primary); font-size: 0.8rem;">(você)</span>
                <% } %>
              </span>
              <span><%= new Date(c.criado_em).toLocaleDateString('pt-BR') %></span>
            </div>
            <div class="comment-text"><%= c.texto %></div>
            <%/* Botão "Excluir" só aparece se é o dono do comentário OU se é admin (moderação) */%>
            <% if (c.usuario_id === userId || userRole === 'admin') { %>
              <form action="/comentario/remover" method="POST" style="margin-top: 1rem; text-align: right;">
                <input type="hidden" name="comentario_id" value="<%= c.id %>">
                <input type="hidden" name="tmdb_movie_id" value="<%= filme.id %>">
                <button type="submit" style="background: none; border: none; color: var(--accent); cursor: pointer; font-size: 0.9rem;">
                  <% if (c.usuario_id !== userId && userRole === 'admin') { %>
                    🛡️ Excluir (Admin)
                  <% } else { %>
                    Excluir
                  <% } %>
                </button>
              </form>
            <% } %>
          </div>
        <% }); %>
      <% } else { %>
        <p style="color: var(--text-muted);">Nenhum comentário ainda. Seja o primeiro a comentar!</p>
      <% } %>
    </div>
  </div>
<script type="module" src="/js/iridescence.js"></script></body>
</html>
