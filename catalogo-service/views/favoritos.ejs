<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>🎬 Tom Hanks Collection | Favoritos</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="brand">🎬 Tom Hanks Collection</a>
    <div class="nav-links">
      <a href="/filmes">Catálogo</a>
      <a href="/favoritos" style="color: var(--primary);">Meus Favoritos</a>
      <a href="/perfil/<%= user.userId || user.id %>">Meu Perfil</a>
      <% if (user.is_premium) { %>
        <span class="user-badge" style="border-color: rgba(245, 158, 11, 0.5); background: rgba(245, 158, 11, 0.15); color: var(--primary); font-weight: 700;">
          ⭐ Premium
        </span>
      <% } else { %>
        <a href="/premium" style="color: var(--primary); font-weight: 600;">⭐ Seja Premium</a>
      <% } %>
      <% if (user.role === 'admin') { %>
        <a href="/admin/usuarios">⚙️ Admin</a>
      <% } %>
      <span class="user-badge <%= user.role === 'admin' ? 'admin-badge' : '' %>">
        👤 <%= user.nome %> <%= user.role === 'admin' ? '(Admin)' : '' %>
      </span>
      <a href="/logout" style="color: var(--accent);">Sair</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
      <h2>Meus Filmes Favoritos</h2>
      <% if (userRole === 'admin' || (typeof isPremium !== 'undefined' && isPremium)) { %>
        <span style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 12px; border-radius: 8px; color: var(--primary); font-size: 0.9rem; font-weight: 600;">
          ⭐ <%= totalFavoritos %> (<%= userRole === 'admin' ? 'Admin: Ilimitado' : 'Premium: Ilimitado' %>)
        </span>
      <% } else { %>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <span style="background: rgba(255, 255, 255, 0.1); padding: 5px 10px; border-radius: 5px; color: <%= totalFavoritos >= limiteFavoritos ? 'var(--accent)' : 'var(--text-muted)' %>; font-size: 0.9rem;">
            ⭐ <%= totalFavoritos %> / <%= limiteFavoritos %>
          </span>
          <a href="/premium" style="background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.4); color: var(--primary); padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none;">
            ⭐ Desbloquear Ilimitado
          </a>
        </div>
      <% } %>
    </div>

    <div class="movies-grid">
      <% if (favoritos.length > 0) { %>
        <% favoritos.forEach(function(f) { %>
          <a href="/filme/<%= f.tmdb_movie_id %>" class="movie-card">
            <!-- STAR BORDER EFFECT -->
            <div class="border-gradient-bottom" style="background: radial-gradient(circle, var(--primary), transparent 10%); animation-duration: 6s;"></div>
            <div class="border-gradient-top" style="background: radial-gradient(circle, var(--primary), transparent 10%); animation-duration: 6s;"></div>
            
            <div class="movie-card-inner">
              <img class="movie-poster" src="https://image.tmdb.org/t/p/w500<%= f.poster_path %>" alt="<%= f.titulo %>">
              <div class="fav-icon">⭐</div>
              <div class="movie-info">
                <div class="movie-title"><%= f.titulo %></div>
                <div style="color: var(--text-muted); font-size: 0.8rem; margin-top: auto;">
                  Salvo em: <%= new Date(f.criado_em).toLocaleDateString('pt-BR') %>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0;">
          <p style="color: var(--text-muted); font-size: 1.2rem; margin-bottom: 1rem;">Você ainda não tem favoritos.</p>
          <a href="/filmes" class="btn btn-primary" style="width: auto; padding: 0.8rem 2rem;">Explorar o Catálogo</a>
        </div>
      <% } %>
    </div>
  </div>
<script type="module" src="/js/iridescence.js"></script></body>
</html>

