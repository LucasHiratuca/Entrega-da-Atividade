<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Logs de Auditoria | Catálogo Tom Hanks</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="brand">🎬 Tom Hanks Collection</a>
    <div class="nav-links">
      <a href="/filmes">Catálogo</a>
      <a href="/favoritos">Meus Favoritos</a>
      <a href="/admin/usuarios" style="color: var(--primary);">⚙️ Admin</a>
      <span class="user-badge admin-badge">👤 <%= user.nome %> (Admin)</span>
      <a href="/logout" style="color: var(--accent);">Sair</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
      <h2>📜 Logs de Auditoria</h2>
      <div style="display: flex; gap: 1rem;">
        <a href="/admin/usuarios" class="btn btn-primary" style="background: var(--surface);">Gerenciar Usuários</a>
      </div>
    </div>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div style="margin-bottom: 1rem; color: var(--text-muted); font-size: 0.9rem;">
      Exibindo <%= logs.length %> de <%= totalLogs %> eventos capturados (Redis Streams).
    </div>

    <div style="overflow-x: auto; background: var(--surface); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 2px solid var(--primary); text-align: left;">
            <th style="padding: 1rem; color: var(--primary);">Data/Hora</th>
            <th style="padding: 1rem; color: var(--primary);">Usuário</th>
            <th style="padding: 1rem; color: var(--primary);">Ação</th>
            <th style="padding: 1rem; color: var(--primary);">Detalhes</th>
            <th style="padding: 1rem; color: var(--primary);">IP (Origem)</th>
          </tr>
        </thead>
        <tbody>
          <% if (logs.length === 0) { %>
            <tr><td colspan="5" style="padding: 2rem; text-align: center; color: var(--text-muted);">Nenhum log registrado ainda.</td></tr>
          <% } else { %>
            <% logs.forEach(function(log) { %>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 1rem; color: var(--text-muted); font-size: 0.9rem;">
                  <%= new Date(log.timestamp).toLocaleString('pt-BR') %>
                </td>
                <td style="padding: 1rem;">
                  <strong><%= log.usuario_nome %></strong><br>
                  <span style="font-size: 0.8rem; color: var(--text-muted);">ID: <%= log.usuario_id %></span>
                </td>
                <td style="padding: 1rem;">
                  <span class="user-badge" style="background: rgba(245, 158, 11, 0.1); color: var(--primary); border: 1px solid var(--primary);">
                    <%= log.acao %>
                  </span>
                </td>
                <td style="padding: 1rem; font-size: 0.95rem; max-width: 300px; word-wrap: break-word;">
                  <%= log.detalhes %>
                </td>
                <td style="padding: 1rem; color: var(--text-muted); font-size: 0.85rem; font-family: monospace;">
                  <%= log.ip %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<script type="module" src="/js/iridescence.js"></script></body>
</html>
