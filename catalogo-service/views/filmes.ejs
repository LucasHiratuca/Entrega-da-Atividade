<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>🎬 Tom Hanks Collection</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="brand">🎬 Tom Hanks Collection</a>
    <div class="nav-links">
      <a href="/filmes">Catálogo</a>
      <a href="/favoritos">Meus Favoritos</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin/usuarios">⚙️ Admin</a>
      <% } %>
      <span class="user-badge <%= user.role === 'admin' ? 'admin-badge' : '' %>">
        👤 <%= user.nome %> <%= user.role === 'admin' ? '(Admin)' : '' %>
      </span>
      <a href="/logout" style="color: var(--accent);">Sair</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h2>Obras da carreira</h2>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="movies-grid">
      <% if (typeof filmes !== 'undefined' && filmes.length > 0) { %>
        <% filmes.forEach(function(filme) { %>
          <a href="/filme/<%= filme.id %>" class="movie-card">
            <!-- STAR BORDER EFFECT -->
            <div class="border-gradient-bottom" style="background: radial-gradient(circle, var(--primary), transparent 10%); animation-duration: 6s;"></div>
            <div class="border-gradient-top" style="background: radial-gradient(circle, var(--primary), transparent 10%); animation-duration: 6s;"></div>
            
            <div class="movie-card-inner">
              <img class="movie-poster" src="https://image.tmdb.org/t/p/w500<%= filme.poster_path %>" alt="<%= filme.title %>">
              <% if (favoritosIds.includes(filme.id)) { %>
                <div class="fav-icon">⭐</div>
              <% } %>
              <div class="movie-info">
                <div class="movie-title"><%= filme.title %></div>
                <div style="color: var(--text-muted); font-size: 0.9rem;">
                  ⭐ <%= filme.vote_average ? filme.vote_average.toFixed(1) : 'N/A' %>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <p>Nenhum filme encontrado.</p>
      <% } %>
    </div>
  </div>
<script type="module" src="/js/iridescence.js"></script></body>
</html>

