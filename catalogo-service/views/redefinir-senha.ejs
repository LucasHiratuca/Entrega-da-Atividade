<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>🎬 Tom Hanks Collection</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrapper">
    <div class="auth-box">
      <a href="/" class="brand" style="justify-content: center; margin-bottom: 2rem;">🎬 Tom Hanks</a>
      
      <% if (error && error.length > 0) { %>
        <div class="alert alert-error"><%= error %></div>
        <div class="links"><a href="/esqueci-senha">Solicitar novo link</a></div>
      <% } else if (token) { %>
        <h2>Nova Senha</h2>
        <form action="/redefinir-senha/<%= token %>" method="POST">
          <div class="form-group">
            <label for="novaSenha">Nova senha</label>
            <input type="password" name="novaSenha" id="novaSenha" required placeholder="Mínimo 6 caracteres">
          </div>
          <div class="form-group">
            <label for="confirmarNovaSenha">Confirmar nova senha</label>
            <input type="password" name="confirmarNovaSenha" id="confirmarNovaSenha" required placeholder="Repita a senha">
          </div>
          <button type="submit" class="btn btn-primary">Salvar Nova Senha</button>
        </form>
      <% } %>
      
    </div>
  </div>
<script type="module" src="/js/iridescence.js"></script></body>
</html>

