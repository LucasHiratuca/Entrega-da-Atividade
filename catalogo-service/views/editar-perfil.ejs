<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>🎬 Tom Hanks Collection | Editar Perfil</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .edit-wrapper {
      max-width: 520px;
      margin: 3rem auto;
      padding: 0 1rem;
    }
    .edit-card {
      background: linear-gradient(145deg, rgba(24,24,27,0.9), rgba(9,9,11,0.95));
      border: 1px solid rgba(255,255,255,0.06);
      border-top: 1px solid rgba(245,158,11,0.25);
      border-radius: 20px;
      padding: 2.5rem;
    }
    .edit-title {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text-light);
      margin-bottom: 0.3rem;
    }
    .edit-sub {
      color: var(--text-muted);
      font-size: 0.875rem;
      margin-bottom: 2rem;
    }
    .form-group { margin-bottom: 1.3rem; }
    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.45rem;
    }
    .form-group textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      background: var(--bg-input, rgba(9,9,11,0.8));
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      color: #fff;
      font-size: 0.95rem;
      font-family: inherit;
      resize: vertical;
      min-height: 110px;
      transition: border-color 0.2s;
    }
    .form-group textarea:focus { outline: none; border-color: rgba(245,158,11,0.4); }
    .form-group input[type=file] {
      width: 100%;
      padding: 0.65rem 1rem;
      background: rgba(9,9,11,0.8);
      border: 1px dashed rgba(255,255,255,0.1);
      border-radius: 10px;
      color: var(--text-muted);
      font-size: 0.875rem;
      cursor: pointer;
    }
    .file-hint {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.4rem;
      opacity: 0.7;
    }
    .btn-save {
      width: 100%;
      padding: 0.8rem;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #09090b;
      border: none;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 0.5rem;
      transition: opacity 0.2s;
    }
    .btn-save:hover { opacity: 0.9; }
    .back-link {
      text-align: center;
      margin-top: 1.2rem;
    }
    .back-link a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
    }
    .back-link a:hover { color: var(--text-light); }

    .alert { padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.2rem; font-size: 0.875rem; }
    .alert-error   { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #86efac; }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="brand">🎬 Tom Hanks Collection</a>
    <div class="nav-links">
      <a href="/filmes">Catálogo</a>
      <a href="/favoritos">Meus Favoritos</a>
      <a href="/perfil/<%= user.userId || user.id %>" style="color: var(--primary);">Meu Perfil</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin/usuarios">⚙️ Admin</a>
      <% } %>
      <span class="user-badge <%= user.role === 'admin' ? 'admin-badge' : '' %>">
        👤 <%= user.nome %> <%= user.role === 'admin' ? '(Admin)' : '' %>
      </span>
      <a href="/logout" style="color: var(--accent);">Sair</a>
    </div>
  </nav>

  <div class="edit-wrapper">
    <div class="edit-card">
      <div class="edit-title">✏️ Editar Perfil</div>
      <p class="edit-sub">Atualize sua bio e foto de perfil.</p>

      <% if (error && error.length) { %>
        <div class="alert alert-error"><%= error[0] %></div>
      <% } %>
      <% if (success && success.length) { %>
        <div class="alert alert-success"><%= success[0] %></div>
      <% } %>

      <form method="POST" action="/perfil/<%= perfilUsuarioId %>/editar" enctype="multipart/form-data">
        <div class="form-group">
          <label for="bio">Bio</label>
          <textarea id="bio" name="bio" maxlength="500" placeholder="Fale um pouco sobre você..."><%= perfil.bio || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="foto">Foto de Perfil</label>
          <input type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/gif,image/webp">
          <p class="file-hint">Formatos aceitos: JPEG, PNG, GIF, WebP — máximo 5 MB</p>
        </div>

        <button type="submit" class="btn-save">💾 Salvar Alterações</button>
      </form>

      <div class="back-link">
        <a href="/perfil/<%= perfilUsuarioId %>">← Voltar ao perfil</a>
      </div>
    </div>
  </div>
</body>
</html>
