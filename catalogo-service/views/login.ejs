<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Login | Catálogo Tom Hanks</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-wrapper">
    <!-- Efeito de Halo/Glow por trás do card estilo Vercel/Linear -->
    <div class="auth-halo"></div>
    
    <div class="auth-box">
      <div class="auth-header">
        <div class="auth-logo-circle">
          <!-- Ícone premium ao invés de apenas texto emoji -->
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
            <path d="M19.82 2l-2.82 2.82a4 4 0 0 1-5.66 0L8.51 2M2 9.5h20M2 14.5h20M2 21a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v18z"/>
          </svg>
        </div>
        <h2>Bem-vindo de volta</h2>
        <p class="auth-subtitle">Acesse para explorar o catálogo exclusivo</p>
      </div>
      
      <% if (error && error.length > 0) { %>
        <div class="alert alert-error" style="display: flex; align-items: center; gap: 0.5rem; justify-content: center; margin-bottom: 1.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <%= error %>
        </div>
      <% } %>
      <% if (success && success.length > 0) { %>
        <div class="alert alert-success" style="display: flex; align-items: center; gap: 0.5rem; justify-content: center; margin-bottom: 1.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <%= success %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="email">E-mail</label>
          <div class="input-icon-wrapper">
            <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <input type="email" name="email" id="email" required placeholder="seu@email.com">
          </div>
        </div>
        <div class="form-group">
          <label for="senha">Senha</label>
          <div class="input-icon-wrapper">
            <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input type="password" name="senha" id="senha" required placeholder="••••••••">
          </div>
        </div>
        
        <button type="submit" class="btn btn-primary btn-icon" style="margin-top: 1rem;">
          Acessar Conta
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
      
      <div class="auth-footer-links">
        <a href="/esqueci-senha" class="text-sm">Esqueceu sua senha?</a>
        <div class="divider"></div>
        <a href="/cadastro" class="text-sm">Não tem uma conta? <span class="text-primary">Cadastre-se grátis</span></a>
      </div>
    </div>
  </div>
<script type="module" src="/js/iridescence.js"></script>
</body>
</html>
