<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>🎬 Tom Hanks Collection | Acesso Negado</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎬</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .denied-wrapper {
      max-width: 520px;
      margin: 5rem auto;
      padding: 0 1rem;
      text-align: center;
    }
    .denied-card {
      background: linear-gradient(145deg, rgba(24,24,27,0.9), rgba(9,9,11,0.95));
      border: 1px solid rgba(239,68,68,0.3);
      border-top: 2px solid rgba(239,68,68,0.6);
      border-radius: 20px;
      padding: 3rem 2.5rem;
    }
    .denied-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.3);
      color: #fca5a5;
      padding: 0.3rem 1rem;
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 1.5rem;
    }
    .denied-title {
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--text-light);
      margin-bottom: 1rem;
    }
    .denied-msg {
      color: #94a3b8;
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      background: rgba(239,68,68,0.05);
      border: 1px solid rgba(239,68,68,0.15);
      padding: 0.8rem 1rem;
      border-radius: 8px;
      font-family: monospace;
      text-align: left;
    }
    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.6rem 1.4rem;
      background: rgba(245,158,11,0.07);
      border: 1px solid rgba(245,158,11,0.2);
      color: var(--primary);
      border-radius: 8px;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: background 0.2s;
    }
    .btn-back:hover { background: rgba(245,158,11,0.14); }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/filmes" class="brand">🎬 Tom Hanks Collection</a>
    <div class="nav-links">
      <a href="/filmes">Catálogo</a>
      <a href="/favoritos">Meus Favoritos</a>
      <a href="/perfil/<%= user.userId || user.id %>">Meu Perfil</a>
      <span class="user-badge">👤 <%= user.nome %></span>
      <a href="/logout" style="color: var(--accent);">Sair</a>
    </div>
  </nav>

  <div class="denied-wrapper">
    <div class="denied-card">
      <div class="denied-badge">🚫 403 — Acesso Negado</div>
      <div class="denied-title">Sem permissão</div>
      <p class="denied-msg"><%= mensagem %></p>
      <a class="btn-back" href="javascript:history.back()">← Voltar</a>
    </div>
  </div>
</body>
</html>
